# MONGODB_URI: Connection string for MongoDB (Atlas or local mongod instance).
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/verihire
# If omitted in preview, VeriHire automatically runs its Mongoose-validated persistent BSON collection engine.
MONGODB_URI="mongodb://127.0.0.1:27017/verihire"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
